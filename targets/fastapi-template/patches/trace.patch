@@ -0,0 +1,30 @@
+import logging
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.core.config import settings
+
+
+def test_log_line_carries_both_trace_headers(
+    client: TestClient, caplog: pytest.LogCaptureFixture
+) -> None:
+    tp = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01"
+    with caplog.at_level(logging.INFO, logger="app.trace"):
+        client.get(
+            f"{settings.API_V1_STR}/utils/health-check/",
+            headers={"traceparent": tp, "X-Test-Trace": "r-1/TC-1/1"},
+        )
+    line = next(r.getMessage() for r in caplog.records if r.name == "app.trace")
+    assert f"traceparent={tp}" in line
+    assert "x-test-trace=r-1/TC-1/1" in line
+    assert " 200 " in line
+
+
+def test_log_line_without_headers_uses_dashes(
+    client: TestClient, caplog: pytest.LogCaptureFixture
+) -> None:
+    with caplog.at_level(logging.INFO, logger="app.trace"):
+        client.get(f"{settings.API_V1_STR}/utils/health-check/")
+    line = next(r.getMessage() for r in caplog.records if r.name == "app.trace")
+    assert line.endswith("traceparent=- x-test-trace=-")
