     allow_headers=["*"],
 )
 
+trace_log = logging.getLogger("app.trace")
+trace_log.setLevel(logging.INFO)  # the root handler prints it; the default level would hide it
+
+
+@app.middleware("http")
+async def log_trace(request: Request, call_next):  # type: ignore[no-untyped-def]
+    """Test platform: one log line per request carrying both trace headers."""
+    status = 500  # an unhandled error propagates from call_next
+    try:
+        response = await call_next(request)
+        status = response.status_code
+        return response
+    finally:
+        trace_log.info(
+            "%s %s %s traceparent=%s x-test-trace=%s",
+            request.method,
+            request.url.path,
+            status,
+            request.headers.get("traceparent", "-"),
+            request.headers.get("x-test-trace", "-"),
+        )
+
+
 app.include_router(api_router, prefix=settings.API_V1_STR)
 app.frontend("/", directory=FRONTEND_DIR)
