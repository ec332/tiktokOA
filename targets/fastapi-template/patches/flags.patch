diff --git a/backend/tests/api/routes/test_flags.py b/backend/tests/api/routes/test_flags.py
new file mode 100644
index 0000000..1544072
--- /dev/null
+++ b/backend/tests/api/routes/test_flags.py
@@ -0,0 +1,90 @@
+"""Each seeded BUG_* flag changes behaviour only when it is on."""
+
+import time
+
+import pytest
+from fastapi.testclient import TestClient
+from pytest import MonkeyPatch
+from sqlmodel import Session
+
+from app import crud
+from app.api.routes import items
+from app.core.config import settings
+from app.models import UserCreate
+from tests.utils.item import create_random_item
+from tests.utils.utils import random_email, random_lower_string
+
+API = settings.API_V1_STR
+
+
+@pytest.mark.parametrize("on", [False, True])
+def test_bug_ownership_update(
+    client: TestClient,
+    normal_user_token_headers: dict[str, str],
+    db: Session,
+    monkeypatch: MonkeyPatch,
+    on: bool,
+) -> None:
+    monkeypatch.setattr(settings, "BUG_OWNERSHIP_UPDATE", on)
+    item = create_random_item(db)  # owned by a different, random user
+    r = client.put(
+        f"{API}/items/{item.id}", headers=normal_user_token_headers, json={"title": "x"}
+    )
+    assert r.status_code == (200 if on else 403)
+
+
+@pytest.mark.parametrize("on", [False, True])
+def test_bug_title_max(
+    client: TestClient,
+    superuser_token_headers: dict[str, str],
+    monkeypatch: MonkeyPatch,
+    on: bool,
+) -> None:
+    monkeypatch.setattr(settings, "BUG_TITLE_MAX", on)
+    r = client.post(
+        f"{API}/items/", headers=superuser_token_headers, json={"title": "t" * 255}
+    )
+    assert r.status_code == (422 if on else 200)
+
+
+@pytest.mark.parametrize("on", [False, True])
+def test_bug_inactive_login(
+    client: TestClient, db: Session, monkeypatch: MonkeyPatch, on: bool
+) -> None:
+    monkeypatch.setattr(settings, "BUG_INACTIVE_LOGIN", on)
+    email, password = random_email(), random_lower_string()
+    crud.create_user(
+        session=db,
+        user_create=UserCreate(email=email, password=password, is_active=False),
+    )
+    r = client.post(
+        f"{API}/login/access-token", data={"username": email, "password": password}
+    )
+    assert r.status_code == (200 if on else 400)
+
+
+def test_bug_flake_race_reads_before_commit(
+    client: TestClient, superuser_token_headers: dict[str, str], monkeypatch: MonkeyPatch
+) -> None:
+    """Forces the race: the commit lands 1s after the response."""
+    monkeypatch.setattr(settings, "BUG_FLAKE_RACE", True)
+    monkeypatch.setattr(items.random, "uniform", lambda _a, _b: 1.0)
+    r = client.post(
+        f"{API}/items/", headers=superuser_token_headers, json={"title": "race"}
+    )
+    assert r.status_code == 200
+    url = f"{API}/items/{r.json()['id']}"
+    assert client.get(url, headers=superuser_token_headers).status_code == 404
+    time.sleep(1.5)
+    assert client.get(url, headers=superuser_token_headers).status_code == 200
+
+
+def test_bug_flake_race_off_commits_before_responding(
+    client: TestClient, superuser_token_headers: dict[str, str], monkeypatch: MonkeyPatch
+) -> None:
+    monkeypatch.setattr(settings, "BUG_FLAKE_RACE", False)
+    r = client.post(
+        f"{API}/items/", headers=superuser_token_headers, json={"title": "ok"}
+    )
+    url = f"{API}/items/{r.json()['id']}"
+    assert client.get(url, headers=superuser_token_headers).status_code == 200
