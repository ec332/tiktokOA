+    }
diff --git a/backend/tests/api/routes/test_testinfo.py b/backend/tests/api/routes/test_testinfo.py
new file mode 100644
index 0000000..9679ca8
--- /dev/null
+++ b/backend/tests/api/routes/test_testinfo.py
@@ -0,0 +1,24 @@
+from fastapi.testclient import TestClient
+from pytest import MonkeyPatch
+
+from app.core.config import settings
+
+
+def test_test_info_reports_clock_and_flags(
+    client: TestClient, monkeypatch: MonkeyPatch
+) -> None:
+    monkeypatch.setattr(settings, "FASTAPI_ENV", "development")
+    r = client.get(f"{settings.API_V1_STR}/utils/test-info/")
+    assert r.status_code == 200
+    body = r.json()
+    assert body["clock"]["source"] == "system"
+    assert body["clock"]["now"]
+    assert isinstance(body["flags"], list)
+
+
+def test_test_info_hidden_outside_development(
+    client: TestClient, monkeypatch: MonkeyPatch
+) -> None:
+    monkeypatch.setattr(settings, "FASTAPI_ENV", None)
+    r = client.get(f"{settings.API_V1_STR}/utils/test-info/")
+    assert r.status_code == 404
