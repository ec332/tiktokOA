+@router.get("/test-info/", include_in_schema=False)
+def test_info() -> dict:
+    """
+    Test platform probe (development only): effective clock and active BUG_* flags.
+    """
+    if settings.FASTAPI_ENV != "development":
+        raise HTTPException(status_code=404, detail="Not Found")
+    flags = sorted(
+        k for k in type(settings).model_fields if k.startswith("BUG_") and getattr(settings, k)
